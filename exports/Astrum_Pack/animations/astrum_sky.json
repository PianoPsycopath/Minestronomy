        "bone_moon_declination": {
          "rotation": [
            "(math.sin((((query.day - 80) / 365.25) * 360) + 180 + (((query.day + query.time_of_day) / 29.53) * 360)) * (23.5 + math.cos((((query.day + query.time_of_day) / 6793.5) * 360)) * 5.14)) + (query.position(2) / 63710 * 2.9)",
            0,
            0
          ]
        },
        "bone_moon_inclination": {
          "rotation": [
            0,
            0,
            5.14
          ]
        },
        "bone_mars_pivot": {
          "rotation": [
            0,
