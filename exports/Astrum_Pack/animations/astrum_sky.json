            "(query.time_of_day * -360) + ((math.sin(2 * ((query.day - 81) / 365.25) * 360) * 9.87 + math.cos(((query.day - 81) / 365.25) * 360) * -7.53 + math.sin(((query.day - 81) / 365.25) * 360) * -1.5) / 4.0)"
          ]
        },
