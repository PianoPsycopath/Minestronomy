+  headerUuid: "f0e1c3d2-4b6a-4c5e-9f8a-1b2c3d4e5f6a",
+  moduleUuid: "a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
+  headerVersion: [1, 2, 2],
+  moduleVersion: [1, 2, 1],
+  minEngineVersion: [1, 21, 80]
+};
